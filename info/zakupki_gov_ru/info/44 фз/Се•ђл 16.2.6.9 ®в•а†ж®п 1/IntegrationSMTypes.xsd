								<xs:documentation>Дата/время публикации документа</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="control99DocsInfo" minOccurs="0">
