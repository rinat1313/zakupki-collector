																	<xs:documentation>Наименование права доступа пользователя</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="status" minOccurs="0">
																<xs:annotation>
																	<xs:documentation>Статус права доступа пользователя:
A - Активно;
B - Заблокировано</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
