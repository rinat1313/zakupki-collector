											<xs:documentation>Телефон</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="email" type="base:eMailType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Адрес электронной почты</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="userAuthoritiesInfo" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Полномочия пользователя</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="userAuthority" maxOccurs="3">
													<xs:annotation>
														<xs:documentation>Полномочие пользователя:

H - руководитель;
A - администратор;
AS - уполномоченный специалист </xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="H"/>
															<xs:enumeration value="A"/>
															<xs:enumeration value="AS"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
