<?xml version="1.0" encoding="UTF-8"?>
<!-- EIS getDocsMIS-ws-api Integration Scheme, version 16.2.6.9, create date 10.08.2026 -->
<xs:schema xmlns="http://zakupki.gov.ru/fz44/get-docs-mis/ws" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:base="http://zakupki.gov.ru/oos/base/1" xmlns:cmn="http://zakupki.gov.ru/oos/common/1" targetNamespace="http://zakupki.gov.ru/fz44/get-docs-mis/ws" elementFormDefault="unqualified" attributeFormDefault="unqualified">
	<xs:import namespace="http://zakupki.gov.ru/oos/base/1" schemaLocation="../../BaseTypes.xsd"/>
	<!--Методы для получения публичных документов Заказчиков-->
	<xs:element name="getPublicDocsRequest" type="getDocsRequestType">
		<xs:annotation>
			<xs:documentation>Запрос формирования в ХД архивов с публичными документами по набору параметров</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="getPublicDocsResponse" type="getDocsResponseType">
		<xs:annotation>
			<xs:documentation>Ответ на запрос формирования в ХД архивов с публичными документами по набору параметров</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="getPublicDocsByReestrNumberRequest" type="getDocsByReestrNumberRequestType">
		<xs:annotation>
			<xs:documentation>Запрос формирования в ХД архивов с публичными документами по реестровому номеру</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="getPublicDocsByReestrNumberResponse" type="getDocsByReestrNumberResponseType">
		<xs:annotation>
			<xs:documentation>Ответ на запрос формирования в ХД архивов с публичными документами по реестровому номеру</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="getPublicDocsByOrgRegionRequest" type="getDocsByOrgRegionRequestType">
		<xs:annotation>
			<xs:documentation>Запрос формирования в ХД архивов с публичными документами по региону заказчика и типу документа</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="getPublicDocsByOrgRegionResponse" type="getDocsByOrgRegionResponseType">
		<xs:annotation>
			<xs:documentation>Ответ на запрос формирования в ХД архивов с публичными документами по региону заказчика и типу документа</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--Методы для получения сокрытых документов Заказчиков-->
	<xs:element name="getHiddenDocsRequest" type="getDocsRequestType">
		<xs:annotation>
			<xs:documentation>Запрос формирования в ХД архивов с сокрытыми документами по набору параметров</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="getHiddenDocsResponse" type="getDocsResponseType">
		<xs:annotation>
			<xs:documentation>Ответ на запрос формирования в ХД архивов с сокрытыми документами по набору параметров</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="getHiddenDocsByReestrNumberRequest" type="getDocsByReestrNumberRequestType">
		<xs:annotation>
			<xs:documentation>Запрос формирования в ХД архивов с сокрытыми документами по реестровому номеру</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="getHiddenDocsByReestrNumberResponse" type="getDocsByReestrNumberResponseType">
		<xs:annotation>
			<xs:documentation>Ответ на запрос формирования в ХД архивов с сокрытыми документами по реестровому номеру</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="getDocSignaturesByUrlRequest">
		<xs:annotation>
			<xs:documentation>Запрос формирования в ХД архивов с подписями документов</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="index" type="indexRequestType">
					<xs:annotation>
						<xs:documentation>Индексная карточка информационного пакета</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="archiveUrl" type="base:hrefType" maxOccurs="1000">
					<xs:annotation>
						<xs:documentation>Ссылка для скачивания архива с документами</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="getDocSignaturesByUrlResponse">
		<xs:annotation>
			<xs:documentation>Ответ на запрос формирования в ХД архивов с подписями документов</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="index" type="indexResponseType">
					<xs:annotation>
						<xs:documentation>Индексная карточка информационного пакета</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="dataInfo">
					<xs:annotation>
						<xs:documentation>Результат обработки запроса</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:choice>
							<xs:element name="docSignaturesInfo" maxOccurs="1000">
								<xs:annotation>
									<xs:documentation>Информация о найденных подписях к документам</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="archiveUrl" type="base:hrefType">
											<xs:annotation>
												<xs:documentation>Ссылка для скачивания архива с документами, которая была получена в запросе</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:choice>
											<xs:element name="archiveWithSignaturesUrl" type="base:hrefType">
												<xs:annotation>
													<xs:documentation>Ссылка для скачивания архива с подписями.

Ссылка отдатся сервисом в двух случаях:
1. подписи найдены
2. подписи не найдены за время синхронного запроса и продолжается асинхронный поиск. В случае, если подписи не будут найдены с помощью асинхронного поиска, то по данной ссылке будет скачан архив, содержащий пустой файл с наименованием noData</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element name="noData" type="xs:boolean" fixed="true">
												<xs:annotation>
													<xs:documentation>Подписи отсутствуют</xs:documentation>
												</xs:annotation>
											</xs:element>
										</xs:choice>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="errorInfo" type="errorInfoType">
								<xs:annotation>
									<xs:documentation>Результат вызова сервиса в случае ошибки</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:choice>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="getHiddenDocsByOrgRegionRequest" type="getDocsByOrgRegionRequestType">
		<xs:annotation>
			<xs:documentation>Запрос формирования в ХД архивов с сокрытыми документами по региону заказчика и типу документа</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="getHiddenDocsByOrgRegionResponse" type="getDocsByOrgRegionResponseType">
		<xs:annotation>
			<xs:documentation>Ответ на запрос формирования в ХД архивов с сокрытыми документами по региону заказчика и типу документа</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--Методы для получения документов Банков-->
	<xs:element name="getHiddenBankDocsRequest">
		<xs:annotation>
			<xs:documentation>Запрос формирования в ХД архивов с сокрытыми документами банков по набору параметров</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="index" type="indexRequestType">
					<xs:annotation>
						<xs:documentation>Индексная карточка информационного пакета</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="selectionParams">
					<xs:annotation>
						<xs:documentation>Параметры отбора документов</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="subsystemType" type="subsystemBank44Type">
								<xs:annotation>
									<xs:documentation>Тип подсистемы для отбора документов.

Актуальные значения для передачи:
RBGB - реестр независимых гарантий</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="periodInfo">
								<xs:annotation>
									<xs:documentation>Период для отбора документов</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:choice>
										<xs:element name="monthInfo">
											<xs:annotation>
												<xs:documentation>Месяц</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="monthNumber" type="base:monthType">
														<xs:annotation>
															<xs:documentation>Номер месяца</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="yearNumber" type="base:yearNewType">
														<xs:annotation>
															<xs:documentation>Год для выбора месяца</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="offsetTimeZone" type="base:timeZoneDifferenceType">
														<xs:annotation>
															<xs:documentation>Смещение часового пояса</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="exactDate" type="xs:date">
											<xs:annotation>
												<xs:documentation>Дата.

Смещение часового учитывается при отборе документов</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="todayInfo">
											<xs:annotation>
												<xs:documentation>Период в течение суток.

Поиск производится по опубликованным в заданном интервале документам.

Вследствие задержки между публикацией и обработкой документов отдача последних опубликованных документов не гарантируется, если указанное значение конца периода отстает от текущего времени менее чем на 1 час</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="fromHour" type="hourType">
														<xs:annotation>
															<xs:documentation>Час начала периода</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="toHour" type="hourType">
														<xs:annotation>
															<xs:documentation>Час конца периода</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="offsetTimeZone" type="base:timeZoneDifferenceType">
														<xs:annotation>
															<xs:documentation>Смещение часового пояса</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="oneHourInfo">
											<xs:annotation>
												<xs:documentation>Период в 1 час.

1. Данный период предназначен для регулярных запросов документов (по таймеру).
2. Данный период позволяет получать в каждом следующем запросе только новые документы, опубликованные за 1 час.
3. Конец периода для поиска вычисляется сервисом.

Для равномерного распределения нагрузки рекомендуется выбрать: 1.случайную минуту [1-60]
2.случайную секунду [1-60]
В данное время необходимо вызывать сервис для получения новых документов</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="date" type="xs:date">
														<xs:annotation>
															<xs:documentation>Дата</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="fromHour" type="fromHourType">
														<xs:annotation>
															<xs:documentation>Час начала периода.

Ограничение: период начала поиска должен отставать от текущего времени более чем на 2 часа.

Примеры:
1. Для запроса документов за промежуток между 00:00 и 01:00 необходимо поле fromHour заполнить значением 0.
Запрос может быть направлен после 02:00.
2. Для запроса документов за промежуток времени между 01:00 и 02:00 необходимо поле fromHour заполнить значением 1. Запрос может быть направлен после 03:00</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="offsetTimeZone" type="base:timeZoneDifferenceType">
														<xs:annotation>
															<xs:documentation>Смещение часового пояса</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:choice>
								</xs:complexType>
							</xs:element>
							<xs:choice>
								<xs:element name="banksInfo">
									<xs:annotation>
										<xs:documentation>Банковские организации для отбора документов</xs:documentation>
									</xs:annotation>
									<xs:complexType>
										<xs:sequence>
											<xs:element name="bankInfo" type="organizationInfo44Type" maxOccurs="100">
												<xs:annotation>
													<xs:documentation>Банковская организация для отбора документов.

Варианты заполнения блока:
1. В каждом элементе коллекции заполнено поле "Код по СПЗ" (reqNum)
2. В каждом элементе коллекции заполнено поле "Код по Сводному Реестру" (consRegistryNum)</xs:documentation>
												</xs:annotation>
											</xs:element>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="isAllBanks" type="xs:boolean" fixed="true">
									<xs:annotation>
										<xs:documentation>Признак запроса документов по всем банковским организациям</xs:documentation>
									</xs:annotation>
								</xs:element>
							</xs:choice>
							<xs:element name="reestrNumber" type="regNumType" minOccurs="0">
								<xs:annotation>
									<xs:documentation>Реестровый номер в подсистеме</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="getHiddenBankDocsResponse">
		<xs:annotation>
			<xs:documentation>Ответ на запрос формирования в ХД архивов с сокрытыми документами банков по набору параметров</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="index" type="indexResponseType">
					<xs:annotation>
						<xs:documentation>Индексная карточка информационного пакета</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="dataInfo">
					<xs:annotation>
						<xs:documentation>Результат обработки запроса</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:choice>
							<xs:element name="banksDocsInfo">
								<xs:annotation>
									<xs:documentation>Документы банковских организаций</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="bankDocsInfo" maxOccurs="100">
											<xs:annotation>
												<xs:documentation>Документы банковской организации</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="bankInfo" type="organizationInfo44Type" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Информация о банке</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:choice>
														<xs:element name="archiveUrl" type="base:hrefType" maxOccurs="1000">
															<xs:annotation>
																<xs:documentation>Ссылка для скачивания архива с документами</xs:documentation>
															</xs:annotation>
														</xs:element>
														<xs:element name="noData" type="xs:boolean" fixed="true">
															<xs:annotation>
																<xs:documentation>Документы отсутствуют</xs:documentation>
															</xs:annotation>
														</xs:element>
													</xs:choice>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="errorInfo" type="errorInfoType">
								<xs:annotation>
									<xs:documentation>Результат вызова сервиса в случае ошибки</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:choice>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--Методы для получения информации о подготовленных архивах по ранее направленному запросу-->
	<xs:element name="getPreparedPartRequest">
		<xs:annotation>
			<xs:documentation>Запрос информации о подготовленных архивах по ранее направленному запросу</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="index" type="indexRequestType">
					<xs:annotation>
						<xs:documentation>Индексная карточка информационного пакета</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:sequence>
					<xs:element name="docRequestUid" type="guidType">
						<xs:annotation>
							<xs:documentation>Глобальный идентификатор ранее направленного запроса на получение документов</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="getPreparedPartResponse">
		<xs:annotation>
			<xs:documentation>Ответ на запрос информации о подготовленных архивах по ранее направленному запросу</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="index" type="indexResponseType">
					<xs:annotation>
						<xs:documentation>Индексная карточка информационного пакета</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="docRequestUid" type="guidType">
					<xs:annotation>
						<xs:documentation>Глобальный идентификатор ранее направленного запроса на получение документов</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:choice>
					<xs:element name="dataInfo">
						<xs:annotation>
							<xs:documentation>Результат обработки запроса</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:element name="isPreparationCompleted" type="xs:boolean">
									<xs:annotation>
										<xs:documentation>Признак завершения подготовки всех архивов по запросу docRequestUid.

false - подготовка архивов продолжается
true - подготовка архивов завершена, все архивы подготовлены</xs:documentation>
									</xs:annotation>
								</xs:element>
								<xs:element name="preparedPartInfo" minOccurs="0" maxOccurs="100000">
									<xs:annotation>
										<xs:documentation>Информация о подготовленных архивах</xs:documentation>
									</xs:annotation>
									<xs:complexType>
										<xs:sequence>
											<xs:element name="dsUid" type="base:UUID32Type">
												<xs:annotation>
													<xs:documentation>Идентификатор архива в ХД</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element name="url" type="base:hrefType">
												<xs:annotation>
													<xs:documentation>Ссылка для скачивания архива</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element name="lastDownloadDT" type="xs:dateTime" minOccurs="0">
												<xs:annotation>
													<xs:documentation>Дата и время последнего скачивания архива.

Если поле не заполнено в ответе, то данный архив не скачивался</xs:documentation>
												</xs:annotation>
											</xs:element>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="preparedNotDownloadPartInfo" minOccurs="0" maxOccurs="100000">
									<xs:annotation>
										<xs:documentation>Информация о подготовленных и еще не скачанных архивах</xs:documentation>
									</xs:annotation>
									<xs:complexType>
										<xs:sequence>
											<xs:element name="dsUid" type="base:UUID32Type">
												<xs:annotation>
													<xs:documentation>Идентификатор архива в ХД</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element name="url" type="base:hrefType">
												<xs:annotation>
													<xs:documentation>Ссылка для скачивания архива</xs:documentation>
