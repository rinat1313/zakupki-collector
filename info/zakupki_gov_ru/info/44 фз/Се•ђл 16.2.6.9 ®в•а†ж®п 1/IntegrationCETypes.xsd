<?xml version="1.0" encoding="UTF-8"?>
<!-- EIS INTEGRATION_UR_TYPES Integration Scheme, version 16.2.6.9, create date 10.08.2026 -->
<xs:schema xmlns="http://zakupki.gov.ru/oos/CETypes/1" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:base="http://zakupki.gov.ru/oos/base/1" xmlns:cmn="http://zakupki.gov.ru/oos/common/1" targetNamespace="http://zakupki.gov.ru/oos/CETypes/1" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:import namespace="http://zakupki.gov.ru/oos/base/1" schemaLocation="BaseTypes.xsd"/>
	<xs:import namespace="http://zakupki.gov.ru/oos/common/1" schemaLocation="CommonTypes.xsd"/>
	<!--ЦРК Сведения об исполнении контракта-->
	<xs:complexType name="contractExecutionPaymentType">
		<xs:annotation>
			<xs:documentation>Тип: Сведения об оплате (возврате оплаты) (ЦРК)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="id" type="xs:long" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор документа в ЕИС</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="externalId" type="base:externalIdType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Внешний идентификатор документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="versionNumber" type="base:versionNumberType1" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Номер версии документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="regNumber" type="base:contractRegNumType">
				<xs:annotation>
					<xs:documentation>Реестровый номер контракта</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="regNumberExecution" type="base:contractRegNumExecutionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Реестровый номер сведений об оплате (возврате оплаты)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="publishDate" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дата размещения документа.

Игнорируется при приеме, заполняется при передаче</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="placer" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Информация об организации, разместившей сведения об оплате (возврате оплаты).

Контролируется обязательность заполнения</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="responsibleOrg" type="cmn:organizationRefType">
							<xs:annotation>
								<xs:documentation>Организация, разместившая cведения об оплате (возврате оплаты)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="responsibleRole" type="base:responsibleRoleCETypeEnum">
							<xs:annotation>
								<xs:documentation>Роль организации, разместившей cведения об оплате (возврате оплаты):

CU - Заказчик;
OA - Организация, осуществляющая полномочия заказчика на осуществление закупок на основании договора (соглашения);
CS - Заказчик, осуществляющий закупки в соответствии с частью 4, 4.3 или 4.4 статьи 15 Федерального закона № 44-ФЗ;
SR - Преемник прав и обязанностей организации, ранее размещавшей информацию и документы в ЕИС;
VHI - Организация, имеющая доступ к информации и документам, не размещаемым на официальном сайте ЕИС</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="contractInfo" type="contractInfo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Общая информация о контракте</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="payDocumentInfo">
				<xs:annotation>
					<xs:documentation>Платежный документ</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="sid" type="base:sIdType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Уникальный идентификатор документа  в ЕИС.

Игнорируется при приеме, добавлен на развитие</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="externalSid" type="base:externalIdType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Внешний идентификатор документа.

Игнорируется при приеме, добавлен на развитие</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="payDocumentType" type="base:payDocumentType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Тип платежа:

PC - Оплата контрагенту;
PT - Оплата налогов, сборов;
PE - Оплата по исполнительному листу;
PN - Оплата неустойки (штрафа, пени)
RC - Возврат оплаты контрагенту;
RE - Возврат оплаты по исполнительному листу
RN - Возврат неустойки (штрафа, пени)

При приеме контролируется обязательность заполнения</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="payDocumentDate" type="xs:date" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дата платежного документа.

При приеме контролируется обязательность заполнения</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="payDocumentNum" type="base:text50Type" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Номер платежного документа.

При приеме контролируется обязательность заполнения</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="refundType" type="base:refundType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Тип возврата:

RB - Возврат от банка получателя;
AR - Дебиторская задолженность прошлых лет;
RC - Возврат от контрагента</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="payDocumentsInfo" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Связанные платежные документы.

Может быть заполнен, если в поле «Тип платежа» (payDocumentInfo/payDocumentType) указаны значения «RC», «RE» и «RN»</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="regNumberExecution" type="base:contractRegNumExecutionType" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>Реестровый номер платежного документа по оплате</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="baseDocumentInfo" type="contractExecutionBaseDocReasonType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Документ-основание</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="currency" type="base:currencyCBRFRef">
							<xs:annotation>
								<xs:documentation>Валюта платежа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="documentPaid" type="base:moneyPositiveType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Сумма оплаты в рамках документа.

Игнорируется при приеме, если признак «Документ формируется на несколько документов-оснований « (payDocumentInfo/baseDocumentInfo/isSeveralBaseDocuments) не установлен в true</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="paid" type="base:moneyPositiveType">
							<xs:annotation>
								<xs:documentation>Сумма в валюте выплаты</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="currencyRate" type="base:currencyRateContract" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Курс валюты на дату документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="paidRUR" type="base:moneyPositiveType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Сумма в рублевом эквиваленте.

Игнорируется при приеме, рассчитывается автоматически  </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="paymentsSumInfo" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Расшифровка по кодам бюджетной классификации.

Блок не может быть заполнен, если в поле «Тип документа-основания» (payDocumentInfo/baseDocumentInfo/baseDocumentType) указано значение "N" (Сведения о начислении неустойки)</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:choice>
										<xs:element name="budgetFinancingsInfo" minOccurs="0" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>Бюджетные средства.

Блок может быть заполнен, если в связанном контракте установлен признак «Закупка за счет бюджетных средств» (заполнен блок //element(*,electronicContractType)/contractFinancingInfo/financingSourcesInfo/budgetFinancingsInfo)</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="sid" type="base:sIdType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Уникальный идентификатор платежа.

Игнорируется при приеме первой версии документа. Назначается в ЕИС и заполняется при передаче.

При приеме изменений, если поле заполнено, то контролируется, что в предыдущей версии документа найден платеж  с указанным значением sid. При этом, если в размещенной версии документа:

1. задан externalSid, то в принимаемой версии для данного платежа по этапу должно быть указано то же значение externalSid;
2. не задан externalSid, то в принимаемой версии допускается указание externalSid</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="externalSid" type="base:externalIdType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Внешний идентификатор платежа </xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="KBK" type="base:kbkType">
														<xs:annotation>
															<xs:documentation>Код бюджетной классификации.

Контролируется на присутствие указанного значения в связанном контракте</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="KOKSCodeInfo" type="base:KOKSRef" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Код ОКС/ОНИ (КОКС)</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="paid" type="base:moneyPositiveType">
														<xs:annotation>
															<xs:documentation>Сумма </xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="paidRUR" type="base:moneyPositiveType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Сумма в рублевом эквиваленте/

Игнорируется при приеме, рассчитывается автоматически</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="nonbudgetFinancingsInfo" minOccurs="0" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>Внебюджетные средства.

Блок может быть заполнен, если в связанном контракте установ-лен признак «Закупка за счет внебюджетных средств» (заполнен блок //element(*,electronicContractType)/contractFinancingInfo/financingSourcesInfo/nonbudgetFinancingsInfo)</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="sid" type="base:sIdType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Уникальный идентификатор платежа

Игнорируется при приеме первой версии документа. Назначается в ЕИС и заполняется при передаче.

При приеме изменений, если поле заполнено, то контролируется, что в предыдущей версии документа найден платеж  с указанным значением sid. При этом, если в размещенной версии документа:

1. задан externalSid, то в принимаемой версии для данного платежа по этапу должно быть указано то же значение externalSid;
2. не задан externalSid, то в принимаемой версии допускается указание externalSid </xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="externalSid" type="base:externalIdType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Внешний идентификатор платежа </xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="KVR" type="base:KVRCodeType">
														<xs:annotation>
															<xs:documentation>Код вида расходов.

Контролируется на присутствие указанного значения в связанном контракте</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="receiptCode" type="base:receiptCodesRef" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Код поступлений
</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="KOKSCodeInfo" type="base:KOKSRef" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Код ОКС/ОНИ (КОКС)</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="paid" type="base:moneyPositiveType">
														<xs:annotation>
															<xs:documentation>Сумма</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="paidRUR" type="base:moneyPositiveType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Сумма в рублевом эквиваленте

Игнорируется при приеме, рассчитывается автоматически  </xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:choice>
									<xs:element name="paidSum" type="base:moneyPositiveType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Общая сумма.

Игнорируется при приеме, рассчитывается автоматически как сумма полей //element(*,contractExecutionPaymentType)/payDocumentInfo/paymentsSumInfo/budgetFinancingsInfo/paid или //element(*,contractExecutionPaymentType)/payDocumentInfo/paymentsSumInfo/nonbudgetFinancingsInfo/paid</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="paidSumRUR" type="base:moneyPositiveType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Общая сумма в рублевом эквиваленте</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="customerInfo" type="customerInfoType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Информация о заказчике.

Игнорируется при приеме, заполняется информацией о заказчике из связанного контракта</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="recipientInfo" type="recipientInfoType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Информация о получателе (плательщике при возврате оплаты)

При приеме контролируется наличие указанного поставщика (подрядчика, исполнителя) в связанном контракте, если в поле  «Тип платежа» (payDocumentInfo/payDocumentType) указаны значения «PC» («Оплата контрагенту») или «RC» («Возврат оплаты контрагенту») </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="modificationReasonInfo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Внесение изменений</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="isModificationReason" type="xs:boolean">
							<xs:annotation>
								<xs:documentation>Внесение изменений в размещенную версию сведений об оплате (возврате оплаты) </xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="printFormInfo" type="cmn:printFormType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Печатная форма документа

Игнорируется при приеме, заполняется при передаче </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="attachmentsInfo" type="cmn:attachmentListWithDSUidType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Документы</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="extPrintForm" type="cmn:extPrintFormType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Электронный документ, полученный из внешней системы

Игнорируется при приеме, добавлено на развитие </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IsMZ" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Закупка малого объема

Игнорируется при приеме, добавлен на развитие</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="schemeVersion" type="base:schemeVersionType" use="required">
			<xs:annotation>
				<xs:documentation>Версия схемы</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="contractExecutionPenaltyAccrualType">
		<xs:annotation>
			<xs:documentation>Тип: Сведения о начислении неустойки (ЦРК)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="id" type="xs:long" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор документа в ЕИС</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="externalId" type="base:externalIdType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Внешний идентификатор документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="versionNumber" type="base:versionNumberType1" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Номер версии документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="regNumber" type="base:contractRegNumType">
				<xs:annotation>
					<xs:documentation>Реестровый номер контракта</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="regNumberExecution" type="base:contractRegNumExecutionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Реестровый номер сведений о начислении неустойки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="publishDate" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дата размещения документа.

Игнорируется при приеме, заполняется при передаче</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="placer">
				<xs:annotation>
					<xs:documentation>Информация об организации, разместившей сведения об оплате (возврате оплаты)</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="responsibleOrg" type="cmn:organizationRefType">
							<xs:annotation>
								<xs:documentation>Организация, разместившая cведения об оплате (возврате оплаты)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="responsibleRole" type="base:responsibleRoleCETypeEnum">
							<xs:annotation>
								<xs:documentation>Роль организации, разместившей cведения об оплате (возврате оплаты):

CU - Заказчик;
OA - Организация, осуществляющая полномочия заказчика на осуществление закупок на основании договора (соглашения);
CS - Заказчик, осуществляющий закупки в соответствии с частью 4, 4.3 или 4.4 статьи 15 Федерального закона № 44-ФЗ;
SR - Преемник прав и обязанностей организации, ранее размещавшей информацию и документы в ЕИС;
VHI - Организация, имеющая доступ к информации и документам, не размещаемым на официальном сайте ЕИС</xs:documentation>
							</xs:annotation>
