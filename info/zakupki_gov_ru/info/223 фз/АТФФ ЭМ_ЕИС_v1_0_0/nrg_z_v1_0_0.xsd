	</xs:complexType>
	<xs:complexType name="attorneyInfo">
		<xs:annotation>
			<xs:documentation>Данные из МЧД</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="regNumber">
				<xs:annotation>
					<xs:documentation>Регистрационный номер доверенности

Номер, присвоенный системой, в которой выдана МЧД</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="255"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="representativeFIO" type="nameInfoMCHD">
				<xs:annotation>
					<xs:documentation>ФИО представителя</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="representativeSNILS">
				<xs:annotation>
					<xs:documentation>СНИЛС представителя</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="\d{10}|\d{11}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="principalFIO" type="nameInfoMCHD">
				<xs:annotation>
					<xs:documentation>ФИО доверителя</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="principalSNILS">
				<xs:annotation>
					<xs:documentation>СНИЛС доверителя</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="\d{10}|\d{11}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="privilegeText">
				<xs:annotation>
					<xs:documentation>Текстовое содержание полномочия</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="10000"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="createDate" type="xs:date">
				<xs:annotation>
					<xs:documentation>Дата выпуска (выдачи)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="validityDate" type="xs:date">
				<xs:annotation>
					<xs:documentation>Срок действия</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="retrustOpportunity" type="xs:string">
				<xs:annotation>
					<xs:documentation>Допустимые значения: 
1 – без права передоверия; 
2 – однократное передоверие; 
3 – с правом последующего передоверия

Передавать текст.
</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="attorneyType" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Признак МЧД

0/false – МЧД выдана в рамках передоверия
1/true – МЧД является первичной
</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="regNumberFirst" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Номер первичной МЧД

Обязателен при условии, что attorneyType = 0/false – МЧД выдана в рамках передоверия</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
