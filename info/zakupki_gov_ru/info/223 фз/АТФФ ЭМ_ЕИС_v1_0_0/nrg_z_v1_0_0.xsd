	<xs:complexType name="baseMessageType" abstract="true">
		<xs:annotation>
			<xs:documentation>Базовый класс для сообщений любого типа</xs:documentation>
			<xs:appinfo>
				<attr:sl value=""/>
			</xs:appinfo>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="messageId" type="xs:string" maxOccurs="1"/>
			<xs:element name="occurDate" type="xs:dateTime" maxOccurs="1"/>
			<xs:element name="parentId" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="childId" type="xs:string" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="INN_KPPtype">
		<xs:annotation>
			<xs:documentation>УИ заказчика/участника</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="INN" type="xs:string">
				<xs:annotation>
					<xs:documentation>ИНН (Аналог ИНН для иностранного лица)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="KPP" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>КПП</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="ogrnCodeType">
		<xs:annotation>
			<xs:documentation>Тип для элементов: Код ОГРН</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="\d{13}|\d{15}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="attachmentsType">
		<xs:annotation>
			<xs:documentation>Коллекция файлов-вложений</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="attachment" type="attachmentType" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="attachmentType">
		<xs:annotation>
			<xs:documentation>Вложение</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="description" type="xs:string" minOccurs="0"/>
			<xs:element name="name" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Имя файла и его расширение в формате «имя файла.расширение».</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="size" type="xs:string" minOccurs="0"/>
			<xs:choice>
				<xs:group ref="linkFieldsType"/>
				<xs:element name="content" type="xs:base64Binary"/>
			</xs:choice>
			<xs:element name="mimeType" type="xs:string" minOccurs="0"/>
			<xs:element name="signatureType" type="xs:int">
				<xs:annotation>
					<xs:documentation>
						0 — присоединенная (не используется, оставлено для обратной совместимости с предыдущими форматами)
                        1 — отсоединенная
                        2 — хеш от файла вложения по алгоритму ГОСТ Р 34.11-2012
                        3 — хеш от файла вложения по алгоритму ГОСТ Р 34.11-94
                        4 — хеш от файла вложения по алгоритму SHA-256
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="signature" type="xs:base64Binary" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:group name="linkFieldsType">
		<xs:annotation>
			<xs:documentation>Элементы для вложений по ссылке: UID — ссылка (часть ссылки) на файл, подставляемая в шаблон с кодом templateId:	templateId — код шаблона, в который подставляется ссылка UID. Если отсутствует, берется шаблон по умолчанию
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID" type="xs:string" minOccurs="1" maxOccurs="1"/>
			<xs:element name="templateId" type="xs:string" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:group>
	<xs:complexType name="POAInfoEM">
		<xs:annotation>
			<xs:documentation>Сведения об МЧД в ЭМ</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="headOrg" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Признак соответствия уполномоченного лица 

0/false – Уполномоченный представитель, действующий на основании МЧД/Неопределенное лицо
1/true – Руководитель/Лицо, имеющее право действовать без МЧД

</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="POAInf" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Признак фиксации МЧД

Обязательно к заполнению при условии, что результат в headOrg - "0/false – Уполномоченный представитель, действующий на основании МЧД/Неопределенное лицо"

Значения для заполнения:
0/false – МЧД не фиксируется ЭТП
1/true – МЧД фиксируется ЭТП

</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="isPOA" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Обязательно к заполнению при условии, что результат в POAInf – «1/true – МЧД фиксируется ЭТП»

Признак наличия МЧД

0/false – МЧД не предоставлена участником контрактной системы
1/true – МЧД предоставлена участником контрактной системы

</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MCHDInf" type="MCHDType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Сведения об МЧД

Обязательно к заполнению при условии, что результат в isPOA - "1/true – МЧД предоставлена участником контрактной системы"</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IPType">
		<xs:annotation>
			<xs:documentation>Сведения об IP-адресе</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="IPUser" type="xs:string">
