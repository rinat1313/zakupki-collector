					<xs:documentation>Дата и время фиксации IP-адреса</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MCHDType">
		<xs:annotation>
			<xs:documentation>МЧД предоставлена участником контрактной системы</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="attorneyInfo" type="attorneyInfo" minOccurs="0">
