					<xs:element name="isModification" type="xs:boolean" minOccurs="1" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>0/false – нет
1/true – внесены изменения
</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="modificationInfo" type="xs:string" minOccurs="0" maxOccurs="1"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
